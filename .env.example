# Inventario de variables de entorno del backend (feature 102).
# Copiar a .env y completar. NUNCA subir un .env con valores reales.
#
# El modulo src/config no carga dotenv: src/index.js, src/seed.js y
# scripts/backfill-permissions.js lo cargan en su primera linea. Si anades un
# entrypoint nuevo, carga dotenv antes de importar config.

# --- Obligatorias: si falta alguna, src/index.js no arranca (ver config.validate()) ---

# Secreto de firma de los JWT. Generar con: openssl rand -hex 32
JWT_SECRET=

# Conexion a MongoDB
MONGODB_URI=mongodb://localhost:27017/dm

# Origen permitido por CORS. Debe incluir esquema, puerto y barra final.
CORS_ORIGIN=http://localhost:8083

# --- Con default: el backend arranca igual si no estan ---

# Puerto del backend. Default real: 3000 (src/config)
PORT=3000

# Entorno de ejecucion. Solo 'production' activa cookies con secure=true.
# NODE_ENV=production

# Vida del token. Formato aceptado por jsonwebtoken. Default: 8h
# TOKEN_EXPIRES_IN=8h

# Directorio de uploads, resuelto contra el cwd del proceso. Default: ./uploads
# UPLOAD_DIR=./uploads

# Dominios de email aceptados en alta e importacion, separados por coma.
# Default: softwareone.com
# ALLOWED_EMAIL_DOMAINS=softwareone.com

# --- SEQ: sin SEQ_SERVER_URL el logger se queda en consola ---

# URL del servidor SEQ
# SEQ_SERVER_URL=http://localhost:5341

# API key de SEQ
# SEQ_API_KEY=

# --- Azure OpenAI: opcional; sin esto las funciones de IA lanzan AI_CONFIG_MISSING ---

# NOTA: docker-compose.yml NO propaga estas variables al contenedor, asi que el
# backend dentro de Docker nunca las ve. Ver AZURE-CONFIG.md seccion 8.

# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_TIMEOUT_MS=240000